+export function mapHighflyJoystickVector(
+  x: number,
+  y: number,
+  deadzone = DEADZONE,
+): { x: number; y: number } {
+  const mag = Math.hypot(x, y);
+  if (!Number.isFinite(mag) || mag <= deadzone) return { x: 0, y: 0 };
+  const clamped = Math.min(1, mag);
+  const radial = (clamped - deadzone) / Math.max(1e-6, 1 - deadzone);
+  return {
+    x: (x / mag) * radial,
+    y: (y / mag) * radial,
+  };
+}
