+    const done = state.completedSessions.includes(key);
+    const viewOnly = selectedWeek !== state.activeWeek;
+    return `
+      <button
+        type="button"
+        class="hf-training-day ${day.day === selectedDay ? 'is-selected' : ''} ${done ? 'is-complete' : ''} ${viewOnly ? 'is-view-only' : ''}"
