+  const rects = el.getClientRects();
+  if (rects.length === 0) return false;
+  const rect = el.getBoundingClientRect();
+  return (
+    style.display !== 'none' &&
+    style.visibility !== 'hidden' &&
+    Number(style.opacity || '1') > 0.01 &&
+    rect.width > 1 &&
+    rect.height > 1
+  );
