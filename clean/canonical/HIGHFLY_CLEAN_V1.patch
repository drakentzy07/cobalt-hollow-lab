+    const result = submitRmCalibration(profile, 'bench_press', {
+      sex: 'male',
+      ageYears: 30,
+      bodyweightKg: 80,
+      loadKg: 180,
+      reps: 5,
+      recordedAt: '2026-10-03T12:00:00.000Z',
