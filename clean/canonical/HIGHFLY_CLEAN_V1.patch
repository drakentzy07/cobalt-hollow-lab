+/* HIGHFLY GAME-C1 — definitive character/combat HUD foundation.
+   Native Claude skills/rigs remain authority. This is layout only. */
+
+body.mobile-touch.hf-game-c1 #actionbar {
+  --hf-c1-skill: 44px;
+  display: block !important;
+  position: fixed !important;
+  inset: 0 !important;
+  width: 100vw !important;
+  height: 100vh !important;
+  pointer-events: none !important;
+  z-index: 180 !important;
+  transform: none !important;
+  background: transparent !important;
+  border: 0 !important;
+  box-shadow: none !important;
+}
+
+body.mobile-touch.hf-game-c1 #actionbar .action-btn[data-hotbar-slot] {
+  display: none !important;
+}
+
+body.mobile-touch.hf-game-c1 #actionbar .action-btn[data-hotbar-slot="1"],
+body.mobile-touch.hf-game-c1 #actionbar .action-btn[data-hotbar-slot="2"],
+body.mobile-touch.hf-game-c1 #actionbar .action-btn[data-hotbar-slot="3"],
+body.mobile-touch.hf-game-c1 #actionbar .action-btn[data-hotbar-slot="4"],
+body.mobile-touch.hf-game-c1 #actionbar .action-btn[data-hotbar-slot="5"],
+body.mobile-touch.hf-game-c1 #actionbar .action-btn[data-hotbar-slot="6"],
+body.mobile-touch.hf-game-c1 #actionbar .action-btn[data-hotbar-slot="7"],
+body.mobile-touch.hf-game-c1 #actionbar .action-btn[data-hotbar-slot="8"],
+body.mobile-touch.hf-game-c1 #actionbar .action-btn[data-hotbar-slot="9"],
+body.mobile-touch.hf-game-c1 #actionbar .action-btn[data-hotbar-slot="10"] {
+  display: flex !important;
+  position: absolute !important;
+  width: var(--hf-c1-skill) !important;
+  height: var(--hf-c1-skill) !important;
+  min-width: var(--hf-c1-skill) !important;
+  min-height: var(--hf-c1-skill) !important;
+  border-radius: 50% !important;
+  margin: 0 !important;
+  pointer-events: auto !important;
+  touch-action: none;
+}
+
+body.mobile-touch.hf-game-c1 #actionbar .keybind,
+body.mobile-touch.hf-game-c1 #actionbar .actionbar-toggle {
+  display: none !important;
+}
+
+/* HIGHFLY C2.1 — compact right cluster, matching the approved hand map.
+   right increases toward screen centre; bottom increases upward. */
+body.mobile-touch.hf-game-c1 #actionbar [data-hotbar-slot="1"]  { right: 110px !important; bottom: 38px !important; }
+body.mobile-touch.hf-game-c1 #actionbar [data-hotbar-slot="2"]  { right: 126px !important; bottom: 92px !important; }
+body.mobile-touch.hf-game-c1 #actionbar [data-hotbar-slot="3"]  { right: 154px !important; bottom: 146px !important; }
+body.mobile-touch.hf-game-c1 #actionbar [data-hotbar-slot="4"]  { right: 154px !important; bottom: 200px !important; }
+body.mobile-touch.hf-game-c1 #actionbar [data-hotbar-slot="5"]  { right: 100px !important; bottom: 254px !important; }
+body.mobile-touch.hf-game-c1 #actionbar [data-hotbar-slot="6"]  { right: 154px !important; bottom: 38px !important; }
+body.mobile-touch.hf-game-c1 #actionbar [data-hotbar-slot="7"]  { right: 180px !important; bottom: 92px !important; }
+body.mobile-touch.hf-game-c1 #actionbar [data-hotbar-slot="8"]  { right: 208px !important; bottom: 146px !important; }
+body.mobile-touch.hf-game-c1 #actionbar [data-hotbar-slot="9"]  { right: 208px !important; bottom: 200px !important; }
+body.mobile-touch.hf-game-c1 #actionbar [data-hotbar-slot="10"] { right: 154px !important; bottom: 254px !important; }
+
+/* Retire donor radial/paged skill chrome; keep native handlers behind C1. */
+body.mobile-touch.hf-game-c1 #mobile-action-ring .mobile-action-slot,
+body.mobile-touch.hf-game-c1 #mobile-action-page-toggle,
+body.mobile-touch.hf-game-c1 #mobile-action-radial,
+body.mobile-touch.hf-game-c1 #mobile-interact {
+  display: none !important;
+}
+
+body.mobile-touch.hf-game-c1 #mobile-action-attack {
+  position: fixed !important;
+  width: 72px !important;
+  height: 72px !important;
+  right: 18px !important;
+  bottom: calc(38px + env(safe-area-inset-bottom)) !important;
+  border-radius: 50% !important;
+  z-index: 184 !important;
+}
+body.mobile-touch.hf-game-c1 #mobile-action-attack::after {
